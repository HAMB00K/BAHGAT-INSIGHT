{
  "name": "Bahgat Insight",
  "dataColors": [
    "#2A78D6",
    "#008300",
    "#E87BA4",
    "#EDA100",
    "#1BAF7A",
    "#EB6834",
    "#4A3AA7",
    "#E34948"
  ],
  "background": "#FCFCFB",
  "foreground": "#0B0B0B",
  "tableAccent": "#2A78D6",
  "good": "#0CA30C",
  "neutral": "#EDA100",
  "bad": "#D03B3B",
  "maximum": "#0D366B",
  "center": "#3987E5",
  "minimum": "#CDE2FB",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 24,
      "color": "#0B0B0B"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#0B0B0B"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#52514E"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#52514E"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FCFCFB"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E1E0D9"
              }
            },
            "radius": 12
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "position": "Outer",
            "preset": "BottomRight",
            "color": {
              "solid": {
                "color": "#0B0B0B"
              }
            },
            "transparency": 93
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0B0B0B"
              }
            },
            "alignment": "left",
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#898781"
              }
            },
            "fontSize": 9,
            "gridlineShow": false,
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#898781"
              }
            },
            "fontSize": 9,
            "gridlineColor": {
              "solid": {
                "color": "#E1E0D9"
              }
            },
            "gridlineStyle": "solid",
            "showAxisTitle": false
          }
        ],
        "legend": [
          {
            "position": "Top",
            "showTitle": false,
            "legendColor": {
              "solid": {
                "color": "#52514E"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F9F9F7"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F9F9F7"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#0B0B0B"
              }
            },
            "fontSize": 24,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#52514E"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "wordWrap": [
          {
            "show": true
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E1E0D9"
              }
            },
            "gridHorizontalWeight": 1,
            "rowPadding": 6,
            "outlineColor": {
              "solid": {
                "color": "#E1E0D9"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#52514E"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F0EFEC"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "Left"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#0B0B0B"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FCFCFB"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FCFCFB"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2,
            "lineStyle": "solid",
            "showMarker": false
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "legend": [
          {
            "position": "Bottom",
            "showTitle": false,
            "fontSize": 9
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    }
  }
}